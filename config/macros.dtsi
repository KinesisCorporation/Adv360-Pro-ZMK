  compatible = "zmk,behavior-macro";
  label = "macro_email_yahoo";
  #binding-cells = <0>;
  bindings = <&kp E>, <&kp T>, <&kp S>, <&kp N0>, <&kp N4>, <&kp U>, <&kp G>, <&kp A>, <&kp AT>, <&kp Y>, <&kp A>, <&kp H>, <&kp O>, <&kp O>, <&kp PERIOD>, <&kp C>, <&kp O>, <&kp M>;
};

macro_email_gmail: macro_email_gmail{
  compatible = "zmk,behavior-macro";
  label = "macro_email_gmail";
  #binding-cells = <0>;
  bindings = <&kp E>, <&kp T>, <&kp S>, <&kp N0>, <&kp N4>, <&kp U>, <&kp G>, <&kp A>, <&kp AT>, <&kp G>, <&kp M>, <&kp A>, <&kp I>, <&kp L>, <&kp PERIOD>, <&kp C>, <&kp O>, <&kp M>;
};

      skq: sticky_key_quick_release {
        compatible = "zmk,behavior-sticky-key";
        #binding-cells = <1>;
        bindings = <&kp>;
        release-after-ms = <1000>;
        quick-release;
        ignore-modifiers;
      };
