  macro_quotes: macro_quotes {
    compatible = "zmk,behavior-macro";
    label = "macro_quotes";
    #binding-cells = <0>;
    bindings = <&kp SQT>, <&kp SQT>, <&kp LEFT>;
  };
  macro_dquotes: macro_dquotes {
    compatible = "zmk,behavior-macro";
    label = "macro_dquotes";
    #binding-cells = <0>;
    bindings = <&kp DQT>, <&kp DQT>, <&kp LEFT>;
  };
  macro_braces: macro_braces {
    compatible = "zmk,behavior-macro";
    label = "macro_braces";
    #binding-cells = <0>;
    bindings = <&kp LBRC>, <&kp RBRC>, <&kp LEFT>;
  };
  macro_parens: macro_parens {
    compatible = "zmk,behavior-macro";
    label = "macro_parens";
    #binding-cells = <0>;
    bindings = <&kp LPAR>, <&kp RPAR>, <&kp LEFT>;
  };
  macro_brackets: macro_brackets {
    compatible = "zmk,behavior-macro";
    label = "macro_brackets";
    #binding-cells = <0>;
    bindings = <&kp LBKT>, <&kp RBKT>, <&kp LEFT>;
  };
  macro_kinesis: macro_kinesis {
    compatible = "zmk,behavior-macro";
    label = "macro_kinesis";
    #binding-cells = <0>;
    bindings = <&kp LS(K)>, <&kp I>, <&kp N>, <&kp E>, <&kp S>, <&kp I>, <&kp S>;
  };

  remove_word_macro: remove_word_macro {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    //   wait-ms = <500>;  // Optional: Adjust the wait time as needed
    bindings = <&macro_press &kp LEFT_ALT> // Press and hold Command
      , <&kp BACKSPACE>                  // Press Backspace while Command is held
      , <&macro_release &kp LEFT_ALT>  // Release Command
      , <&macro_wait_time 20>
      , <&macro_release &kp LEFT_ALT>  // Release Command
      , <&macro_release &kp BACKSPACE>  // Release Command
    ;
    label = "REMOVE_WORD_MACRO";
  };

  remove_line_macro: remove_line_macro {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_press &kp LEFT_COMMAND>  // Press and hold Command
      , <&kp BACKSPACE>                  // Press Backspace
      , <&macro_wait_time 50>
      , <&macro_release &kp LEFT_COMMAND>  // Release Command
      , <&macro_wait_time 20>
      , <&macro_release &kp LEFT_COMMAND>  // Release Command
      , <&macro_release &kp BACKSPACE>  // Release Command
    ;
    label = "REMOVE_LINE_MACRO";
  };

  todo_macro: todo_macro {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <2>;  // Wait time between actions
    bindings = <&kp FSLH &kp FSLH &kp SPACE &kp LS(T) &kp LS(O) &kp LS(D) &kp LS(O) &kp SPACE &kp LBKT &kp LS(R) &kp LS(H) &kp RIGHT_BRACKET &kp COLON>;
    label = "TODO_MACRO";
  };

  todo_escaped_macro: todo_escaped_macro {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <2>;  // Wait time between actions
    bindings = <&kp BSLH &kp FSLH &kp BSLH &kp FSLH &kp SPACE &kp LS(T) &kp LS(O) &kp LS(D) &kp LS(O) &kp SPACE &kp BSLH &kp LBKT &kp LS(R) &kp LS(H) &kp BSLH &kp RIGHT_BRACKET &kp BSLH &kp COLON>;
    label = "TODO_ESCAPED_MACRO";
  };

  secure_access_macro: secure_access_macro {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <2>;
    bindings = <&kp LS(S)>, <&kp E>, <&kp C>, <&kp U>, <&kp R>, <&kp E>, <&kp LS(A)>, <&kp C>, <&kp C>, <&kp E>, <&kp S>, <&kp S>;
    label = "SECURE_ACCESS_MACRO";
  };

  rabbit_macro: rabbit_macro {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <2>;
    bindings = <&kp LS(R)>, <&kp A>, <&kp B>, <&kp B>, <&kp I>, <&kp T>;
    label = "RABBIT_MACRO";
  };

  vim_save_all_macro: vim_save_all_macro {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <2>;
    bindings = <&kp ESCAPE>, <&kp COLON>, <&kp W>, <&kp A>, <&kp ENTER>;
    label = "VIM_SAVE_ALL_MACRO";
  };

    // This does not work (only spotlight is oppeining but nothing is typing there)
  spotlight_open_slack_macro: spotlight_open_slack_macro {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <2>;
    bindings = 
      <&macro_press &kp LEFT_COMMAND>, <&kp SPACE>  // Open Spotlight
      , <&macro_release &kp LEFT_COMMAND>  // Release Command early
      , <&macro_wait_time 50>
      , <&macro_release &kp LEFT_COMMAND>  // Release Command early
      , <&macro_wait_time 400>  // Increase wait for Spotlight focus
      , <&kp S>
      , <&macro_wait_time 50>
      , <&kp L>
      , <&macro_wait_time 50>
      , <&kp A>
      , <&macro_wait_time 50>
      , <&kp C>
      , <&macro_wait_time 50>
      , <&kp K>
      , <&macro_wait_time 200>
      , <&kp ENTER>
    ;
    label = "SPOTLIGHT_OPEN_SLACK";
  };


