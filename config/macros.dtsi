word_select: word_select {
    compatible = "zmk,behavior-macro";
    label = "WORD_SELECT";
    #binding-cells = <0>;
    bindings =
        <&macro_press &kp LALT>,
        <&macro_tap &kp RIGHT>,
        <&macro_press &kp LSHIFT>,
        <&macro_tap &kp LEFT>,
        <&macro_release &kp LSHIFT>,
        <&macro_release &kp LALT>;
};

td_triple_c: tap_dance_triple_c {
    compatible = "zmk,behavior-tap-dance";
    label = "TAP_DANCE_TRIPLE_C";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings =
      <&kp C>
      , <&kp LS(C)>
      , <&kp LG(C)>
      ;
};

td_triple_a: tap_dance_triple_a {
    compatible = "zmk,behavior-tap-dance";
    label = "TAP_DANCE_TRIPLE_A";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings =
        <&kp A>,           // Single tap: 'a'
        <&kp LS(A)>,       // Double tap: 'A'
        <&kp LG(A)>        // Triple tap: Alt+A
        ;
};

td_triple_v: tap_dance_triple_v {
    compatible = "zmk,behavior-tap-dance";
    label = "TAP_DANCE_TRIPLE_V";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings =
        <&kp V>,           // Single tap: 'a'
        <&kp LS(V)>,       // Double tap: 'A'
        <&kp LG(V)>;       // Triple tap: Alt+A
};

td_triple_z: tap_dance_triple_z {
    compatible = "zmk,behavior-tap-dance";
    label = "TAP_DANCE_TRIPLE_Z";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings =
        <&kp Z>,           // Single tap: 'a'
        <&kp LS(Z)>,       // Double tap: 'A'
        <&kp LG(Z)>;       // Triple tap: Alt+A
};

// Shift key: tap once for shift, twice for caps lock
td_shift: tap_dance_shift {
    compatible = "zmk,behavior-tap-dance";
    label = "TAP_DANCE_SHIFT";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings = <&kp LSHIFT>, <&caps_word>;
};

// Backspace: tap once for backspace, twice for delete word
td_bspc: tap_dance_backspace {
    compatible = "zmk,behavior-tap-dance";
    label = "TAP_DANCE_BACKSPACE";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings = <&kp BACKSPACE>,
              <&macro_press &kp LALT &kp BACKSPACE>;
};

// Quote key: tap once for single quote, twice for double quote
td_quote: tap_dance_quote {
    compatible = "zmk,behavior-tap-dance";
    label = "TAP_DANCE_QUOTE";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings = <&kp SQT>, <&kp DQT>;
};

// Enter: tap once for enter, twice for shift+enter (new line)
td_enter: tap_dance_enter {
    compatible = "zmk,behavior-tap-dance";
    label = "TAP_DANCE_ENTER";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings = <&kp ENTER>, <&kp LS(ENTER)>;
};

// Layer toggle: tap once for momentary, twice to toggle
td_layer: tap_dance_layer {
    compatible = "zmk,behavior-tap-dance";
    label = "TAP_DANCE_LAYER";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings = <&mo>, <&tog>;
};

macro_close_file: macro_close_file {
  compatible = "zmk,behavior-macro";
  label = "macro_close_file";
  #binding-cells = <0>;
  bindings = <&mt LEFT_CONTROL K>, <&mt LEFT_CONTROL W>;
};

