  win_double_tap: win_double_tap {
    compatible = "zmk,behavior-macro-one-param";
    label = "WIN_DOUBLE_TAP";
    #binding-cells = <1>;
    tap-ms = <0>;  // Disable default tap duration since we're handling manually
    wait-ms = <0>; // Disable default wait since we're using explicit waits
    bindings = <
        &macro_press &kp LGUI
        &macro_param_1to1 &macro_press &kp MACRO_PLACEHOLDER
        &macro_wait_time 60  // Brief hold for the first "tap" to register as a press
        &macro_param_1to1 &macro_release &kp MACRO_PLACEHOLDER
        &macro_wait_time 120  // Pause between taps to ensure separation
        &macro_param_1to1 &macro_press &kp MACRO_PLACEHOLDER
        &macro_wait_time 60  // Hold for the second "tap"
        &macro_param_1to1 &macro_release &kp MACRO_PLACEHOLDER
        &macro_release &kp LGUI
    >;
  };
  win_single_tap: win_single_tap {
    compatible = "zmk,behavior-macro-one-param";
    label = "WIN_SINGLE_TAP";
    #binding-cells = <1>;
    tap-ms = <0>;
    wait-ms = <0>;
    bindings = <
        &macro_press &kp LGUI
        &macro_wait_time 30
        &macro_param_1to1 &macro_press &kp MACRO_PLACEHOLDER
        &macro_wait_time 60
        &macro_param_1to1 &macro_release &kp MACRO_PLACEHOLDER
        &macro_wait_time 30
        &macro_release &kp LGUI
    >;
  };