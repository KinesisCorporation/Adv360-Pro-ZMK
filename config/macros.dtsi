#define SHRUG_EMOJI &uc 1F937
/* ¯ */
#define HIGH_PIPE &uc U+00AF

/* ツ */
#define SMILE &uc U+30C4

macro_md_url: macro_md_url{
compatible = "zmk,behavior-macro";
label = "macro_md_url";
#binding-cells = <0>;
bindings = <&kp LBKT>, <&kp RBKT>, <&kp LPAR>, <&kp RPAR>, <&kp LEFT>;
};

macro_md_image: macro_md_image{
compatible = "zmk,behavior-macro";
label = "macro_md_image";
#binding-cells = <0>;
bindings = <&kp EXCL>, <&kp LBKT>, <&kp RBKT>, <&kp LPAR>, <&kp RPAR>, <&kp LEFT>, <&kp LC(V)>;
};

macro_screenshot: macro_screenshot{
compatible = "zmk,behavior-macro";
label = "macro_screenshot";
#binding-cells = <0>;
bindings = <&macro_press &kp LGUI &kp LCTRL>, <&macro_tap &kp SPACE>, <&macro_release &kp LGUI &kp LCTRL>;
};

macro_emoticonmenu: macro_emoticonmenu{
compatible = "zmk,behavior-macro";
label = "macro_emoticonmenu";
#binding-cells = <0>;
bindings = <&macro_press &kp LGUI &kp LSHIFT>, <&macro_tap &kp N4>, <&macro_release &kp LGUI &kp LSHIFT>;
};

macro_layer_4: macro_layer_4{
compatible = "zmk,behavior-macro";
label = "macro_layer_4";
#binding-cells = <0>;
bindings = <&kp L>, <&kp A>, <&kp Y>, <&kp E>, <&kp R>, <&kp SPACE>, <&kp N4>;
};

macro_layer_3: macro_layer_3{
compatible = "zmk,behavior-macro";
label = "macro_layer_3";
