/* <img src="databricks_architecture.png" width="800" /> */
macro_md_image: macro_md_image{
compatible = "zmk,behavior-macro";
label = "macro_md_image";
#binding-cells = <0>;
bindings
    = <&kp LESS_THAN>
    , <&kp I>
    , <&kp M>
    , <&kp G>
    , <&kp SPACE>
    , <&kp W>
    , <&kp I>
    , <&kp D>
    , <&kp T>
    , <&kp H>
    , <&kp EQUAL>
    , <&kp DQT>
    , <&kp N8>
    , <&kp N0>
    , <&kp N0>
    , <&kp P>
    , <&kp X>
    , <&kp DQT>
    , <&kp SPACE>
    , <&kp S>
    , <&kp R>
    , <&kp C>
    , <&kp EQUAL>
    , <&kp DQT>
    , <&kp DQT>
    , <&kp SPACE>
    , <&kp BSLH>
    , <&kp GREATER_THAN>
    , <&kp LEFT>
    , <&kp LEFT>
    , <&kp LEFT>
    , <&kp LEFT>
    , <&kp LG(C)>
    ;
};

macro_shruggy1: macro_shruggy1 {
            compatible = "zmk,behavior-macro";
            label = "macro_shruggy1";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N5>
                , <&macro_release &kp LALT>
                , <&macro_tap &kp MINUS &kp BSLH>
                , <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N8 &kp KP_N3>
                , <&macro_release &kp LALT>
                , <&macro_tap &kp FSLH>
                ;
        };

