macro_md_code_block: macro_md_code_block {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    label = "Markdown Code Block";
    bindings = <&kp GRAVE>
        , <&kp GRAVE>
        , <&kp GRAVE>
        , <&kp GRAVE>
        , <&kp ENTER>
        , <&kp GRAVE>
        , <&kp GRAVE>
        , <&kp LEFT>
        , <&kp LEFT>
        , <&kp LEFT>;
};

