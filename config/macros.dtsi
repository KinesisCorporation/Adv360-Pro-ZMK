macro_all_delete: macro_all_delete{
compatible = "zmk,behavior-macro";
label = "macro_all_delete";
#binding-cells = <0>;
bindings = <&kp LG(A)>, <&kp DEL>;
};
macro_braces_back: macro_braces_back{
compatible = "zmk,behavior-macro";
label = "macro_braces_back";
#binding-cells = <0>;
bindings = <&kp LBRC>, <&kp RBRC>, <&kp LEFT>;
};
macro_brackets_back: macro_brackets_back{
  compatible = "zmk,behavior-macro";
  label = "macro_brackets_back";
  #binding-cells = <0>;
  bindings = <&kp LBKT>, <&kp RBKT>, <&kp LEFT>;
};

macro_tab_previous: macro_tab_previous {
  label = "macro_tab_previous";
  compatible = "zmk,behavior-macro";
  #binding-cells = <0>;
  bindings
     = <&macro_press &kp LCTRL>
     , <&macro_press &kp LSHFT>
     , <&macro_tap &kp TAB>
     , <&macro_release &kp LSHFT>
     , <&macro_release &kp LCTRL>
     ;
};

macro_tab_next: macro_tab_next {
            label = "macro_tab_next";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp TAB>
                , <&macro_release &kp LCTRL>
                ;
        };

macro_emoticonmenu: macro_emoticonmenu{
  compatible = "zmk,behavior-macro";
  label = "macro_emoticonmenu";
  #binding-cells = <0>;
  bindings = <&macro_press &kp LGUI &kp LSHIFT>, <&macro_tap &kp N4>, <&macro_release &kp LGUI &kp LSHIFT>;
};

macro_md_url: macro_md_url{
  compatible = "zmk,behavior-macro";
  label = "macro_md_url";
  #binding-cells = <0>;
  bindings = <&kp LBKT>, <&kp RBKT>, <&kp LPAR>, <&kp RPAR>, <&kp LEFT>, <&kp LEFT>, <&kp LEFT>;
};

macro_md_choices: macro_md_choices{
  compatible = "zmk,behavior-macro";
  label = "macro_md_choices";
  #binding-cells = <0>;
  bindings = <&kp POUND>, <&kp POUND>, <&kp SPACE>, <&kp LS(C)>, <&kp H>, <&kp O>, <&kp I>, <&kp C>, <&kp E>, <&kp S>;
};

macro_md_answer: macro_md_answer{
  compatible = "zmk,behavior-macro";
  label = "macro_md_answer";
  #binding-cells = <0>;
  bindings = <&kp POUND>, <&kp POUND>, <&kp SPACE>, <&kp LS(A)>, <&kp N>, <&kp S>, <&kp W>, <&kp E>, <&kp R>;
};

macro_md_explanation: macro_md_explanation{
  compatible = "zmk,behavior-macro";
  label = "macro_md_explanation";
  #binding-cells = <0>;
  bindings = <&kp POUND>, <&kp POUND>, <&kp SPACE>, <&kp LS(E)>, <&kp X>, <&kp P>, <&kp L>, <&kp A>, <&kp N>, <&kp A>, <&kp T>, <&kp I>, <&kp O>, <&kp N>;
};

/* <img src="databricks_architecture.png" width="800" /> */
macro_md_image: macro_md_image{
compatible = "zmk,behavior-macro";
label = "macro_md_image";
#binding-cells = <0>;
bindings
    = <&kp LESS_THAN>
    , <&kp I>
    , <&kp M>
    , <&kp G>
    , <&kp SPACE>
    , <&kp W>
    , <&kp I>
    , <&kp D>
    , <&kp T>
    , <&kp H>
    , <&kp EQUAL>
    , <&kp DQT>
    , <&kp N8>
    , <&kp N0>
    , <&kp N0>
    , <&kp P>
    , <&kp X>
    , <&kp DQT>
    , <&kp SPACE>
    , <&kp S>
    , <&kp R>
    , <&kp C>
    , <&kp EQUAL>
    , <&kp DQT>
    , <&kp DQT>
    , <&kp SPACE>
    , <&kp BSLH>
    , <&kp GREATER_THAN>
    , <&kp LEFT>
    , <&kp LEFT>
    , <&kp LEFT>
    , <&kp LEFT>
    , <&kp LG(C)>
    ;
};

macro_shruggy1: macro_shruggy1 {
            compatible = "zmk,behavior-macro";
            label = "macro_shruggy1";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N5>
                , <&macro_release &kp LALT>
                , <&macro_tap &kp MINUS &kp BSLH>
                , <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N8 &kp KP_N3>
                , <&macro_release &kp LALT>
                , <&macro_tap &kp FSLH>
                ;
        };

