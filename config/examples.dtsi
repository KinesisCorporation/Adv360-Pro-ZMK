label = "macro_shruggy1";
#binding-cells = <0>;
bindings = <HIGH_PIPE>;
};

macro_shruggy2: macro_shruggy2{
compatible = "zmk,behavior-macro";
label = "macro_shruggy2";
#binding-cells = <0>;
bindings = <&SHRUG_EMOJI>;
};
*/

macro_example_kinesis: macro_example_kinesis{
compatible = "zmk,behavior-macro";
label = "macro_example_kinesis";
#binding-cells = <0>;
bindings = <&kp LS(K)>, <&kp I>, <&kp N>, <&kp E>, <&kp S>, <&kp I>, <&kp S>;
};

macro_example1: macro_example1{
compatible = "zmk,behavior-macro";
label = "macro_example1";
#binding-cells = <0>;
bindings = <&kp LS(E)>, <&kp LS(T)>, <&kp LS(S)>;
};

macro_example2: macro_example2{
compatible = "zmk,behavior-macro";
label = "macro_example2";
#binding-cells = <0>;
bindings = <&kp LS(E)>, <&kp LS(T)>, <&kp LS(S)>;
};