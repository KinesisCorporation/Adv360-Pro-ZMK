/**
 * Key positions

#define KEYS_LEFT  0  1  2  3  4  5  6 \
                  14 15 16 17 18 19 20 \
                  28 29 30 31 32 33 34 \
                     46 47 48 49 50 51 \
                        60 61 62 63 64

#define KEYS_RIGHT  7  8  9 10 11 12 13 \
                   21 22 23 24 25 26 27 \
                   39 40 41 42 43 44 45 \
                      54 55 56 57 58 59 \
                         71 72 73 74 75

#define THUMBS_LEFT 35 36 52 65 66 67

#define THUMBS_RIGHT 37 38 53 68 69 70

*/


/{
  combos {
    compatible = "zmk,combos";
    combo_esc {
      timeout-ms = <30>;
      key-positions = <30 31>; // S D
      layers = <0>;
      bindings = <&kp ESC>;
    };

    combo_tab {
      timeout-ms = <30>;
      key-positions = <31 32>; // D F
      layers = <0>;
      bindings = <&kp TAB>;
    };

    combo_bspc {
      timeout-ms = <30>;
      key-positions = <41 42>; // J K
      layers = <0>;
      bindings = <&kp BSPC>;
    };

    combo_enter {
      timeout-ms = <30>;
      key-positions = <42 43>; // K L
      layers = <0>;
      bindings = <&kp ENTER>;
    };

    combo_left_bracket {
      timeout-ms = <30>;
      key-positions = <23 41>; // U J
      layers = <0>;
      bindings = <&kp LBKT>;
    };

    combo_right_bracket {
      timeout-ms = <30>;
      key-positions = <25 43>; // O L
      layers = <0>;
      bindings = <&kp RBKT>;
    };
  };

  combo_right_round_bracket {
      timeout-ms = <60>;
      key-positions = <41 55>; // J M
      layers = <0>;
      bindings = <&kp RBKT>;
    };

  combo_left_round_bracket {
      timeout-ms = <60>;
      key-positions = <43 57>; // L .
      layers = <0>;
      bindings = <&kp LBKT>;
    };

  combo_grave {
      timeout-ms = <60>;
      key-positions = <16 30>; // W S
      layers = <0>;
      bindings = <&kp GRAVE>;
    };

  combo_grave2 {
      timeout-ms = <60>;
      key-positions = <16 17>; // W E
      layers = <0>;
      bindings = <&kp GRAVE>;
    };

  combo_sticky_layer_2 {
      timeout-ms = <60>;
      key-positions = <73 74>; // ESC LEFT ARROW
      layers = <0>;
      bindings = <&sl 2>;
    };

};
