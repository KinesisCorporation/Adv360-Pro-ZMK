#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &tog 1                                                                         &mo 3          &kp N6    &kp N7         &kp N8         &kp N9        &kp N0          &kp MINUS
        &kp TAB        &kp Q        &kp W        &kp F        &kp P        &kp G        &none                                                                          &none          &kp J     &kp L          &kp U          &kp Y         &kp SEMI        &kp BSLH
        &kp ESC        &kp A        &kp R        &kp S        &kp T        &kp D        &macro_oumlaut             &kp LCTRL  &kp LALT  &kp LGUI  &kp RCTRL            &macro_aumlaut &kp H     &kp N          &kp E          &kp I         &kp O           &kp SQT
        &kp LSHFT      &kp Z        &kp X        &kp C        &kp V        &kp B                                             &kp HOME  &kp PG_UP                                      &kp K     &kp M          &kp DOT        &kp COMMA     &kp FSLH        &kp RSHFT
        &mo 2          &kp GRAVE    &kp CAPS     &mo 4        &mo 5                                      &kp BSPC  &kp DEL  &kp END  &kp PG_DN  &kp ENTER  &kp SPACE                            &mo 6          &mo 7          &kp LBKT      &kp RBKT        &mo 2
      >;
    };
    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &trans                                                                         &mo 3          &kp N6    &kp KP_NUM     &kp KP_EQUAL   &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB        &kp Q        &kp W        &kp F        &kp P        &kp G        &none                                                                          &none          &kp J     &kp KP_N7      &kp KP_N8      &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC        &kp A        &kp R        &kp S        &kp T        &kp D        &macro_oumlaut             &kp LCTRL  &kp LALT  &kp LGUI  &kp RCTRL            &macro_aumlaut &kp H     &kp KP_N4      &kp KP_N5      &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT      &kp Z        &kp X        &kp C        &kp V        &kp B                                             &kp HOME  &kp PG_UP                                      &kp K     &kp KP_N1      &kp KP_N2      &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2          &kp GRAVE    &kp CAPS     &mo 4        &mo 5                                      &kp BSPC  &kp DEL  &kp END  &kp PG_DN  &kp ENTER  &kp KP_N0                            &mo 6          &mo 7          &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1         &kp F2       &kp F3       &kp F4       &kp F5       &kp F6       &tog 1                                                                         &mo 3          &kp F7    &kp F8         &kp F9         &kp F10       &kp F11         &kp F12
        &trans         &trans       &trans       &trans       &trans       &trans       &trans                                                                         &trans         &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans       &trans       &trans                          &trans  &trans  &trans  &trans                 &trans         &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans       &trans                                               &trans  &trans                                        &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans                                            &trans  &trans  &trans  &trans  &trans  &trans                                  &trans         &trans         &trans        &trans          &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                          &trans         &none     &none          &none          &none         &none           &none
        &none          &none        &none        &none        &none        &none        &bootloader                                                                    &bootloader    &none     &none          &none          &none         &none           &none
        &studio_unlock &none        &none        &none        &none        &none        &none                          &none  &none  &bt BT_CLR  &none                 &stp STP_BAT   &none     &none          &none          &none         &none           &none
        &none          &none        &none        &none        &macro_ver   &none                                                 &none  &none                                         &none     &none          &none          &none         &none           &none
        &none          &none        &none        &none        &none                                        &none  &none  &none  &none  &bl BL_TOG  &rgb_ug RGB_TOG                              &bl BL_INC     &bl BL_DEC     &none         &none           &none
      >;
    };
    extra1 {
      display-name = "Mouse";
      bindings = <
        &trans         &trans       &trans       &trans       &trans       &trans       &trans                                                                         &trans         &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans       &trans       &none                                                                          &trans         &mkp LCLK &mkp RCLK      &mkp MCLK      &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans       &trans       &none                           &trans  &trans  &trans  &trans                 &none          &trans    &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP  &mmv MOVE_RIGHT &mkp LCLK
        &trans         &trans       &trans       &trans       &trans       &trans                                               &trans  &trans                                        &trans    &msc SCRL_UP   &msc SCRL_DOWN &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans                                            &trans  &trans  &trans  &trans  &trans  &trans                                  &trans         &trans         &trans        &trans          &trans
      >;
    };
    extra2 {
      display-name = "Navigation";
      bindings = <
        &trans         &trans       &trans       &trans       &trans       &trans       &trans                                                                         &trans         &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans       &trans       &none                                                                          &trans         &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans       &trans       &none                           &trans  &trans  &trans  &trans                 &none          &trans    &kp LEFT       &kp DOWN       &kp UP        &kp RIGHT       &trans
        &trans         &trans       &trans       &trans       &trans       &trans                                               &trans  &trans                                        &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans                                            &trans  &trans  &trans  &trans  &trans  &trans                                  &trans         &trans         &trans        &trans          &trans
      >;
    };
    extra3 {
      display-name = "Symbol";
      bindings = <
        &trans         &trans       &trans       &trans       &trans       &trans       &trans                                                                         &trans         &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &kp AT       &kp HASH     &kp LPAR     &kp RPAR     &kp PRCNT    &none                                                                          &trans         &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &kp EXCL     &kp DLLR     &kp LBRC     &kp RBRC     &kp AMPS     &none                           &trans  &trans  &trans  &trans                 &none          &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &kp PIPE     &kp CARET    &kp LBKT     &kp RBKT     &kp STAR                                             &trans  &trans                                        &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans                                            &trans  &trans  &trans  &trans  &trans  &trans                                  &trans         &trans         &trans        &trans          &trans
      >;
    };
    extra4 {
      display-name = "Yellow";
      bindings = <
        &trans         &trans       &trans       &trans       &trans       &trans       &trans                                                                         &trans         &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans       &trans       &trans                                                                         &trans         &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans       &trans       &trans                          &trans  &trans  &trans  &trans                 &trans         &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans       &trans                                               &trans  &trans                                        &trans    &trans         &trans         &trans        &trans          &trans
        &trans         &trans       &trans       &trans       &trans                                            &trans  &trans  &trans  &trans  &trans  &trans                                  &trans         &trans         &trans        &trans          &trans
      >;
    };
  };
};
