#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
#include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp EXCLAMATION  &kp LEFT_BRACKET  &kp LBRC     &kp LEFT_PARENTHESIS  &kp PERCENT  &kp DOLLAR                                                 &mo 5      &kp CARET  &kp RPAR  &kp RBRC   &kp RBKT  &kp STAR   &kp MINUS
&kp TAB    &kp Q            &kp W             &kp E        &kp R                 &kp T        &none                                                      &none      &kp Y      &kp U     &kp I      &kp O     &kp P      &kp FSLH
&kp ESC    &kp A            &kp S             &kp D        &kp F                 &kp G        &none       &kp LCTRL  &kp LALT      &kp RGUI   &kp RCTRL  &none      &kp H      &kp J     &kp K      &kp L     &kp SEMI   &kp SQT
&mo 1      &kp Z            &kp X             &kp C        &kp V                 &kp B                               &kp HOME      &kp PG_UP                        &kp N      &kp M     &kp COMMA  &kp DOT   &kp BSLH   &mo 1
&mo 4      &kp GRAVE        &kp HASH          &kp AT_SIGN  &kp AMPERSAND                      &kp BSPC    &kp LSHFT  &kp END       &kp PG_DN  &kp ENTER  &kp SPACE             &kp LEFT  &kp DOWN   &kp UP    &kp RIGHT  &mo 4
            >;
        };

        shift_layer {
            display-name = "Shift";
            bindings = <
&kp PLUS  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &none                                       &none   &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp UNDER
&trans    &kp LS(Q)  &kp LS(W)  &kp LS(E)  &kp LS(R)  &kp LS(T)  &none                                       &none   &kp LS(Y)  &kp LS(U)  &kp LS(I)  &kp LS(O)  &kp LS(P)  &kp QMARK
&trans    &kp LS(A)  &kp LS(S)  &kp LS(D)  &kp LS(F)  &kp LS(G)  &none   &trans  &trans      &trans  &trans  &none   &kp LS(H)  &kp LS(J)  &kp LS(K)  &kp LS(L)  &kp COLON  &kp DQT
&trans    &kp LS(Z)  &kp LS(X)  &kp LS(C)  &kp LS(V)  &kp LS(B)                  &trans      &trans                  &kp LS(N)  &kp LS(M)  &kp LT     &kp GT     &kp PIPE   &trans
&trans    &kp TILDE  &trans     &trans     &trans                &trans  &trans  &trans      &trans  &trans  &trans             &trans     &trans     &trans     &trans     &trans
            >;
        };

        gaming_layer {
            display-name = "Gaming";
            bindings = <
&kp ESC     &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &tog 3                                               &mo 5     &kp N6  &kp N7    &kp N8     &kp N9   &kp N0     &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E   &kp R   &kp T   &none                                                &none     &kp Y   &kp U     &kp I      &kp O    &kp P      &kp FSLH
&kp LCTRL   &kp A   &kp S   &kp D   &kp F   &kp G   &none      &none      &none         &kp RGUI  &none  &none     &kp H   &kp J     &kp K      &kp L    &kp SEMI   &kp SQT
&kp LSHIFT  &kp Z   &kp X   &kp C   &kp V   &kp B                         &none         &none                      &kp N   &kp M     &kp COMMA  &kp DOT  &kp BSLH   &none
&mo 4       &none   &none   &kp N   &kp M           &kp SPACE  &kp ENTER  &kp LALT      &none     &none  &kp BSPC          &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT  &none
            >;
        };

        gaming_manage_layer {
            display-name = "Gaming Manage";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &mo 5  &trans  &trans  &trans  &trans  &trans  &none
&trans  &trans  &trans  &trans  &kp I   &kp J   &none                                      &none  &none   &none   &none   &none   &none   &none
&trans  &trans  &trans  &trans  &trans  &kp P   &none   &none   &none       &none   &none  &none  &none   &none   &none   &none   &none   &none
&trans  &trans  &trans  &trans  &kp O   &kp K                   &trans      &trans                &none   &none   &none   &none   &none   &none
&mo 4   &none   &none   &none   &none           &trans  &trans  &trans      &none   &none  &none          &none   &none   &none   &none   &none
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 0                                      &mo 5   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                    &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                              &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &tog 0  &tog 2      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                              &none       &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none   &none       &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
