#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  4
#define SYM  5
#define TYP  6
#define SHRT 7

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      lth: layer_tap_hold {
          compatible = "zmk,behavior-hold-tap";
          label = "LAYER_TAP_HOLD";
          #binding-cells = <2>;
          flavor = "hold-preferred";
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          bindings = <&mo>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 1                                                           &mo 3 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &mo TYP  &lth NAV PG_UP                        &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &mo SHRT  &lth SYM PG_DN &kp ENTER &kp SPACE              &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >;
    };
    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &trans &trans                     &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &trans &trans &trans &trans &trans &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    nav {
      display-name = "NAV";
      status = "okay";
      bindings = <
        &trans &trans       &trans        &trans        &trans        &trans &trans                                      &trans &trans       &trans       &trans      &trans       &trans       &trans
        &trans &trans       &trans        &trans        &trans        &trans &none                                       &none  &trans       &kp HOME     &kp END      &kp PG_UP    &kp PG_DN    &trans
        &trans &kp LG(LEFT) &kp LA(LEFT)  &kp LA(RIGHT) &kp LG(RIGHT) &kp LA(DEL) &none &trans &trans &trans &trans        &none  &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &trans       &trans
        &trans &kp LA(BSPC) &kp LG(BSPC)  &trans        &trans        &trans &trans                                      &trans &trans       &trans       &trans      &trans       &trans       &trans
        &trans &trans       &trans        &trans        &trans               &trans &trans &trans &trans &trans &trans              &trans       &trans       &trans      &trans       &trans
      >;
    };
    sym {
      display-name = "SYM";
      status = "okay";
      bindings = <
        &trans &trans     &trans      &trans     &trans     &trans     &trans                                  &trans &trans      &trans    &trans   &trans       &trans     &trans
        &trans &trans     &trans      &trans     &trans     &trans     &none                                   &none  &trans      &trans    &trans   &trans       &trans     &trans
        &trans &kp LPAR   &kp RPAR    &kp LBRC   &kp RBRC   &kp LBKT   &none &trans &trans &trans &trans     &none  &kp RBKT    &kp LT    &kp GT   &kp EQUAL   &kp PLUS  &trans
        &trans &kp GRAVE  &kp TILDE   &kp PIPE   &kp BSLH   &kp UNDER  &trans                                  &trans &trans      &kp MINUS &trans   &trans       &trans     &trans
        &trans &trans     &trans      &trans     &trans              &trans &trans &trans &trans &trans &trans             &trans      &trans   &trans       &trans     &trans
      >;
    };
    typ {
      display-name = "TYP";
      status = "okay";
      bindings = <
        &trans &trans                    &trans             &trans          &trans             &trans              &trans                                  &trans &trans                   &trans                    &trans                    &trans                    &trans       &trans
        &trans &trans                    &trans             &trans          &trans             &trans              &none                                   &none  &trans                   &trans                    &trans                    &trans                    &trans       &trans
        &trans &kp LA(LS(MINUS))         &kp LA(MINUS)      &kp LA(SEMI)    &kp LA(LBKT)       &kp LA(LS(LBKT))   &none &trans &trans &trans &trans     &none  &kp LA(RBKT)            &kp LA(LS(RBKT))        &kp LA(BSLH)             &kp LA(LS(BSLH))        &kp LA(SPACE) &trans
        &trans &trans                    &trans             &trans          &trans             &trans              &trans                                  &trans &trans                   &trans                    &trans                    &trans       &trans
        &trans &trans                    &trans             &trans          &trans              &trans &trans &trans &trans &trans &trans             &trans                   &trans                    &trans                    &trans       &trans
      >;
    };
    shrt {
      display-name = "SHRT";
      status = "okay";
      bindings = <
        &trans &trans          &trans            &trans              &trans                 &trans             &trans                                  &trans &trans          &trans               &trans                    &trans              &trans           &trans
        &trans &trans          &trans            &trans              &trans                 &trans             &none                                   &none  &trans          &trans               &trans                    &trans              &trans           &trans
        &trans &kp LG(SPACE)   &kp LCTRL(UP)     &kp LG(LS(N4))      &kp LG(LS(N5))        &kp LG(TAB)        &none &trans &trans &trans &trans     &none  &kp LG(LS(TAB)) &kp LG(P)          &kp LG(LS(P))             &kp LG(SLASH)       &kp LG(D)        &trans
        &trans &kp LG(LS(K))  &kp LA(UP)        &kp LA(DOWN)        &trans                 &kp LG(B)          &trans                                  &trans &trans          &kp LG(I)            &kp LG(K)                 &kp LG(LS(V))       &trans           &trans
        &trans &trans          &trans            &trans              &trans              &trans &trans &trans &trans &trans &trans             &trans                   &trans                    &trans                    &trans       &trans
      >;
    };
  };
};
