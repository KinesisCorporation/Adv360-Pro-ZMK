#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "macros.dtsi"
#include "combos.dtsi"

/ {
  keymap {
    compatible = "zmk,keymap";

    /* ===============================
     * Layer 0 — Insert
     * =============================== */
    base {
      bindings = <
        /* 左手 */
        &kp Q   &kp W   &kp E   &kp R   &kp T
        &kp A   &kp S   &kp D   &kp F   &kp G
        &kp Z   &kp X   &kp C   &kp V   &kp B

        /* 右手 */
        &kp Y   &kp U   &kp I   &kp O   &kp P
        &kp H   &kp J   &kp K   &kp L   &kp SEMI
        &kp N   &kp M   &kp COMMA &kp DOT &kp SLASH

        /* 親指クラスタ */
        &ht &mo 1 &kp SPACE     /* Tap: Space / Hold: Nav */
        &kp LCTRL               /* 左親指 Ctrl */
        &kp LALT                /* 左親指 Alt */

        &ht &mo 2 &kp ENTER     /* Tap: Enter / Hold: Fn */
        &kp LGUI                /* 右親指 Cmd (GUI) */
        &kp LSHIFT              /* 右親指 Shift */
      >;
    };

    /* ===============================
     * Layer 1 — Vim Normal DSL
     * =============================== */
    nav {
      bindings = <
        /* オペレータ（左手） */
        &kp D      &kp C      &kp Y      &macro_dd &macro_cc
        &kp U      &kp R      &macro_x   &kp P     &kp DEL
        &macro_iw &macro_aw &macro_ip &macro_ap &macro_yy

        /* モーション（右手） */
        &kp H &kp J &kp K &kp L &kp END
        &kp W &kp B &kp E &kp N &kp DOLLAR
        &kp PAGE_DOWN &kp PAGE_UP &kp HOME &macro_gg &kp G

        /* 親指（Nav 層） */
        &trans &trans &trans
        &kp ENTER &trans &kp ESC
      >;
    };

    /* ===============================
     * Layer 2 — Fn
     * =============================== */
    fn {
      bindings = <
        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
        &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
        &kp F11 &kp F12 &kp BRIGHTNESS_UP &kp BRIGHTNESS_DOWN &kp MUTE

        &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp CAPS
        &kp HOME &kp PG_DN &kp PG_UP &kp END &kp INS

        &trans &trans &trans
        &trans &trans &trans
      >;
    };
  };
};

