#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&mt { flavor = "balanced"; };

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        chrome_switch: chrome_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &kp C &kp H &kp R &kp O &kp M &kp E &kp ENTER>;
            label = "CHROME_SWITCH";
        };

        intelli_j_switch: intelli_j_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &kp I &kp N &kp T &kp ENTER>;
            label = "INTELLI_J_SWITCH";
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick_tap_ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };
    };

    macros {
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL            &kp N1     &kp N2     &kp N3    &kp N4     &kp N5  &caps_word                                                                                                    &mo 2       &kp N6  &kp N7    &kp N8        &kp N9    &kp N0         &kp MINUS
&kp TAB              &kp Q      &kp W      &kp E     &kp R      &kp T   &mo 1                                                                                                         &mo 1       &kp Y   &kp U     &kp I         &kp O     &kp P          &kp BSLH
&mt LCTRL ESC        &kp A      &kp S      &kp D     &kp F      &kp G   &chrome_switch  &kp LEFT_GUI  &mt LEFT_ALT ENTER                &kp RIGHT_ALT                  &kp RIGHT_GUI  &caps_word  &kp H   &kp J     &kp K         &kp L     &kp SEMICOLON  &mt RIGHT_CONTROL SQT
&kp LSHFT            &kp Z      &kp X      &kp C     &kp V      &kp B                                 &mt LEFT_CONTROL C_VOLUME_UP      &mt RIGHT_CONTROL C_VOLUME_UP                             &kp N   &kp M     &kp COMMA     &kp DOT   &kp FSLH       &kp RSHFT
&mt LEFT_CONTROL F1  &kp GRAVE  &kp UNDER  &kp LEFT  &kp RIGHT          &kp BSPC        &kp DELETE    &kp C_VOLUME_DOWN                 &kp C_VOLUME_DOWN              &kp ENTER      &kp SPACE           &kp DOWN  &kp UP_ARROW  &kp LBKT  &kp RBKT       &intelli_j_switch
            >;
        };

        Functionality {
            bindings = <
&kp F1  &kp F2  &kp F3                    &kp F4  &kp F5  &kp F6      &trans                                             &trans  &kp F7             &kp F8                &kp F9                    &kp F10                &kp F11  &kp F12
&trans  &trans  &trans                    &trans  &trans  &bl BL_INC  &trans                                             &trans  &kp C_VOLUME_UP    &trans                &trans                    &trans                 &trans   &trans
&trans  &trans  &kp RG(LS(LC(NUMBER_4)))  &trans  &trans  &bl BL_DEC  &trans  &trans  &trans             &trans  &trans  &trans  &kp C_VOLUME_DOWN  &kp C_PREVIOUS        &kp C_PLAY_PAUSE          &kp C_NEXT             &trans   &trans
&trans  &trans  &trans                    &trans  &trans  &trans                      &trans             &trans                  &trans             &kp LA(LC(LG(LEFT)))  &kp LA(LC(LG(C)))         &kp LA(LC(LG(RIGHT)))  &trans   &trans
&trans  &trans  &trans                    &trans  &trans              &trans  &trans  &kp RG(LC(Q))      &trans  &trans  &trans                     &kp LC(LA(LG(DOWN)))  &kp LC(LA(LG(UP_ARROW)))  &trans                 &trans   &trans
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &macro_ver    &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
