#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        macshot: macshot {
            compatible = "zmk,behavior-tap-dance";
            label = "MACSHOT";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(X))>, <&kp LS(LG(F))>;
        };

        copypaste: copypaste {
            compatible = "zmk,behavior-tap-dance";
            label = "COPYPASTE";
            #binding-cells = <0>;
            bindings = <&kp LG(V)>, <&mt LG(X) LG(C)>;
        };
    };

    macros {
        phauk: phauk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(P) &kp I &kp N &kp K &kp LS(H) &kp A &kp U &kp K &kp N8>;
            label = "PHAUK";
        };

        tmalt: tmalt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp T &kp R &kp N1 &kp P &kp L &kp N3 &kp LS(M) &kp AT &kp LS(L) &kp LS(T)>;
            label = "TMALT";
        };

        comult: comult {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp C &kp O &kp DOT &kp M &kp U &kp L &kp T &kp N &kp O &kp M &kp A &kp H &kp DOT &kp O &kp R &kp DOT &kp U &kp S>;
            label = "COMULT";
        };

        techop: techop {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(R) &kp LS(A) &kp LS(W) &kp LS(N) &kp G &kp O &kp N &kp E &kp AT &kp N2 &kp N0 &kp N2 &kp N5 &kp DOT>;
            label = "TECHOP";
        };
    };

    combos {
        compatible = "zmk,combos";

        capsword {
            bindings = <&caps_word>;
            key-positions = <35 38>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2  &kp N3    &kp N4            &kp N5            &tog 1                                                                                                                       &mo 3             &kp N6             &kp N7             &kp N8        &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W   &kp E     &kp R             &kp T             &macshot                                                                                                                     &none             &kp Y              &kp U              &kp I         &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S   &kp D     &hm LEFT_SHIFT F  &hm LEFT_SHIFT G  &copypaste                  &kp LEFT_GUI  &kp LEFT_CONTROL                        &kp RIGHT_CONTROL           &kp RIGHT_GUI  &kp C_PLAY_PAUSE  &hm RIGHT_SHIFT H  &hm RIGHT_SHIFT J  &kp K         &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X   &kp C     &kp V             &kp B                                                       &mt LEFT_ALT SPACE                      &kp PG_UP                                                    &kp N              &kp M              &kp COMMA     &kp DOT   &kp FSLH  &kp ENTER
&mo 2      &kp GRAVE  &kp F8  &kp LEFT  &lt 4 RIGHT                         &mt LS(LC(LG(LALT))) ENTER  &kp DEL       &mt LS(LC(LG(LEFT_ALT))) BACKSPACE      &mt RC(RS(RALT)) PAGE_DOWN  &kp BACKSPACE  &kp SPACE                            &kp DOWN_ARROW     &kp UP_ARROW  &kp LBKT  &kp RBKT  &kp RIGHT_SHIFT
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2           &kp N3           &kp N4           &kp N5        &trans                                                           &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_SLASH  &none                                                            &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS  &none         &kp LCTRL      &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT                                 &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &trans
&mo 2      &kp GRAVE  &kp KP_NUMBER_0  &kp LEFT         &kp KP_NUMBER_0                &kp KP_ENTER  &kp BACKSPACE  &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &phauk        &techop       &tmalt        &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &comult       &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        Navigation {
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                  &none  &none           &none           &none         &none      &none  &none
&none  &none  &none  &none  &none  &none  &none                                  &none  &none           &none           &none         &none      &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &none  &none
&none  &none  &none  &none  &none  &none                &none      &none                &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END    &none  &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none                  &none           &none         &none      &none  &none
            >;
        };
    };
};
