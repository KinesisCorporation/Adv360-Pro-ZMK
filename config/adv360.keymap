#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO
      macro_ver: macro_ver {
        compatible = "zmk,behavior-macro";
        label = "macro_version";
        #binding-cells = <0>;
        bindings = <&kp RET>;
      };
      #endif

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      hm_win: homerow_win_macro {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_WIN_MACRO";
          #binding-cells = <2>;
          tapping-term-ms = <400>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&win_double_tap>, <&win_single_tap>;
      };

    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &kp ESC   &kp N1         &kp N2   &kp N3          &kp N4     &kp N5 &mo 3                                                                  &mo 3           &kp N6 &kp N7 &kp N8           &kp N9   &kp N0           &kp MINUS
        &kp TAB   &kp Q          &kp W    &kp E           &kp R      &kp T  &kp F9                                                                 &kp C_VOL_UP    &kp Y  &kp U  &kp I            &kp O    &kp P            &kp BSLH
        &mo 1     &kp A          &kp S    &hm LSHIFT D    &kp F      &kp G  &kp F8              &kp LGUI  &kp LALT &kp DEL     &mo 2               &kp C_VOL_DN    &kp H  &kp J  &hm LSHIFT K     &kp L    &kp SEMI         &kp SQT
        &kp LSHFT &kp Z          &kp X    &kp C           &kp V      &kp B                                &kp HOME &kp PG_UP                                       &kp N  &kp M  &kp COMMA        &kp DOT  &kp FSLH         &kp RSHFT
        &kp LSHFT &kp GRAVE      &kp CAPS &kp LEFT        &kp RIGHT                    &kp BSPC &kp LCTRL &kp END  &kp PG_DN   &kp ENTER &kp SPACE                        &kp UP &kp DOWN         &kp LBKT &kp RBKT         &kp PRINTSCREEN
      >;
    };
    keypad {
      bindings = <
        &kp EQUAL       &kp N1    &kp N2            &kp N3             &kp N4              &kp N5           &trans                                                                                   &mo 3 &kp N6           &kp KP_NUM &macro_select_star &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB         &kp Q     &kp W             &kp E              &macro_return       &macro_log_time  &trans                                                                                   &none &macro_braces    &kp KP_N7  &kp KP_N8          &kp KP_N9     &kp AT          &kp BSLH
        &kp ESC         &kp A     &hm_win N1 N1     &hm_win N2 N2      &hm_win N3 N3       &kp LG(N4)       &kp LG(N5)           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL                              &none &macro_parens    &kp KP_N4  &kp KP_N5          &kp KP_N6     &kp EQUAL       &macro_python_comment
        &kp CAPS        &kp Z     &kp LG(N6)        &hm_win N7 N7      &kp LG(N8)          &kp B                                                 &kp HOME &kp PG_UP                                        &macro_brackets  &kp KP_N1  &kp KP_N2          &kp KP_N3     &kp KP_PLUS     &kp RSHFT
        &bootloader     &kp GRAVE &kp CAPS          &kp LC(LA(MINUS))  &kp LC(LS(MINUS))                                      &kp BSPC &kp ENTER &kp END  &kp PG_DN &macro_next_line &kp KP_N0                              &macro_up  &macro_down        &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };
    fn {
      bindings = <
        &trans &kp F1                 &kp F2      &kp F3             &kp F4                   &kp F5                   &tog 1                                          &mo 3                &kp F6 &kp F7              &kp F8                &kp F9           &kp F10      &kp F11
        &trans &trans                 &trans      &trans             &macro_log_time_research &macro_log_time_meeting  &none                                           &kp C_BRIGHTNESS_INC &trans &trans              &macro_python_class   &kp LC(LA(DEL))  &macro_pass  &kp F12
        &trans &macro_lead_acceptance &macro_spec &macro_debug       &trans                   &trans                   &none        &trans &trans &trans &trans        &kp C_BRIGHTNESS_DEC &trans &trans              &trans                &trans           &trans       &kp F13
        &trans &trans                 &trans      &macro_log_time_cr &trans                   &trans                                       &trans &trans                                    &trans &macro_log_time_mgt &trans                &trans           &trans       &trans
        &trans &trans                 &trans      &trans             &trans                                                  &trans &trans &trans &trans &trans &trans                             &trans              &trans                &trans           &trans       &trans
      >;
    };
    mod {
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans                                                                         &trans                 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none
        &none &none        &none        &none        &none        &none        &rgb_ug RGB_MEFS_CMD 5                                                         &rgb_ug RGB_MEFS_CMD 5 &none        &none        &none        &none        &none        &none
        &none &none        &none        &none        &none        &none        &bootloader                  &none &none &bt BT_CLR &none                      &bootloader            &none        &none        &none        &none        &none        &none
        &none &none        &none        &none        &macro_ver   &none                                           &none &none                                                        &none        &none        &none        &none        &none        &none
        &none &none        &none        &none        &none                                            &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none        &none        &none
      >;
    };
  };
};
