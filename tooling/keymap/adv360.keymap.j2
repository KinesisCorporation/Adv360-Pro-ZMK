#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

{% for behavior in behaviors %}
      {{ behavior.id }}: {{ behavior.name }} {
          compatible = "{{ behavior.compatible }}";
          label = "{{ behavior.label }}";
          #binding-cells = <{{ behavior.binding_cells }}>;
          tapping-term-ms = <{{ behavior.tapping_term_ms }}>;
          quick-tap-ms = <{{ behavior.quick_tap_ms }}>;
          flavor = "{{ behavior.flavor }}";
          bindings = {{ behavior.bindings | join(', ') }};
      };
{% endfor %}
    };

  keymap {
    compatible = "zmk,keymap";

{% for layer in layers %}
    {{ layer.name }} {
      display-name = "{{ layer.display_name }}";
{% if layer.status == "reserved" %}
      status = "reserved";
{% else %}
      bindings = <
{% for line in layer.binding_lines %}
        {{ line }}
{% endfor %}
      >;
{% endif %}
    };
{% endfor %}
  };
};
